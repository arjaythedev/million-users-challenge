{
    "name": "gabidj/million-users-feed",
    "type": "project",
    "description": "Feed API for the Million Users Challenge: Laravel + Octane (Swoole) + PDO pgsql",
    "require": {
        "php": "^8.3",
        "ext-pdo_pgsql": "*",
        "ext-swoole": "*",
        "laravel/framework": "^12.0",
        "laravel/octane": "^2.0"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
