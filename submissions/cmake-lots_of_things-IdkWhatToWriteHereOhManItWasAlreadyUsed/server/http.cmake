# server/http.cmake
# Парсинг сырого HTTP + отправка ответа.

# ---- ответ ----
function(send_response STATUS REASON BODY)
  string(LENGTH "${BODY}" BLEN)
  set(RESP "HTTP/1.1 ${STATUS} ${REASON}\r\n")
  string(APPEND RESP "Content-Type: application/json\r\n")
  string(APPEND RESP "Content-Length: ${BLEN}\r\n")
  string(APPEND RESP "Connection: keep-alive\r\n")
  string(APPEND RESP "\r\n")
  string(APPEND RESP "${BODY}")
  execute_process(COMMAND ${CMAKE_COMMAND} -E echo_append "${RESP}")
endfunction()

function(send_error STATUS REASON MSG)
  string(REPLACE "\\" "\\\\" MSG "${MSG}")
  string(REPLACE "\"" "\\\"" MSG "${MSG}")
  send_response(${STATUS} "${REASON}" "{\"error\":\"${MSG}\"}")
endfunction()

# ---- парсинг ----
# Возвращает в PARENT_SCOPE: METHOD, PATH, QUERY, AUTH, BODY
function(parse_request RAW)
  set(METHOD "" PARENT_SCOPE)
  set(PATH   "" PARENT_SCOPE)
  set(QUERY  "" PARENT_SCOPE)
  set(AUTH   "" PARENT_SCOPE)
  set(BODY   "" PARENT_SCOPE)

  if(RAW STREQUAL "")
    return()
  endif()
  string(REPLACE "\r\n" "\n" RAW "${RAW}")

  string(FIND "${RAW}" "\n\n" SEP)
  if(SEP EQUAL -1)
    set(HEADERS "${RAW}")
    set(BODY_LOCAL "")
  else()
    math(EXPR BS "${SEP} + 2")
    string(SUBSTRING "${RAW}" 0 ${SEP} HEADERS)
    string(SUBSTRING "${RAW}" ${BS} -1 BODY_LOCAL)
  endif()

  string(REPLACE "\n" ";" HLINES "${HEADERS}")
  list(GET HLINES 0 REQUEST_LINE)
  separate_arguments(REQUEST_LINE UNIX_COMMAND "${REQUEST_LINE}")
  list(LENGTH REQUEST_LINE RL)
  if(RL LESS 2)
    return()
  endif()
  list(GET REQUEST_LINE 0 M)
  list(GET REQUEST_LINE 1 PQ)

  string(FIND "${PQ}" "?" QP)
  if(QP GREATER -1)
    math(EXPR QS "${QP} + 1")
    string(SUBSTRING "${PQ}" 0 ${QP} P)
    string(SUBSTRING "${PQ}" ${QS} -1 Q)
  else()
    set(P "${PQ}")
    set(Q "")
  endif()

  set(A "")
  set(CL 0)
  list(REMOVE_AT HLINES 0)
  foreach(L IN LISTS HLINES)
    if(L MATCHES "^[Aa]uthorization:[ ]*(.*)$")
      set(A "${CMAKE_MATCH_1}")
    elseif(L MATCHES "^[Cc]ontent-[Ll]ength:[ ]*([0-9]+)")
      set(CL "${CMAKE_MATCH_1}")
    endif()
  endforeach()

  if(CL GREATER 0)
    string(LENGTH "${BODY_LOCAL}" BL)
    if(BL GREATER CL)
      string(SUBSTRING "${BODY_LOCAL}" 0 ${CL} BODY_LOCAL)
    endif()
  endif()

  set(METHOD "${M}"  PARENT_SCOPE)
  set(PATH   "${P}"  PARENT_SCOPE)
  set(QUERY  "${Q}"  PARENT_SCOPE)
  set(AUTH   "${A}"  PARENT_SCOPE)
  set(BODY   "${BODY_LOCAL}" PARENT_SCOPE)
endfunction()

function(read_request OUT)
  set(RAW "")
  if(EXISTS "/dev/stdin")
    file(READ "/dev/stdin" RAW LIMIT 65536)
  endif()
  set(${OUT} "${RAW}" PARENT_SCOPE)
endfunction()