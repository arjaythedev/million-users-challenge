

function(check_auth AUTH_HEADER SECRET)
  set(AUTH_OK   FALSE PARENT_SCOPE)
  set(AUTH_SUB  ""    PARENT_SCOPE)
  set(AUTH_USERNAME "" PARENT_SCOPE)
  set(AUTH_ERR  ""    PARENT_SCOPE)

  if(AUTH_HEADER STREQUAL "")
    set(AUTH_ERR "missing" PARENT_SCOPE)
    return()
  endif()
  if(NOT AUTH_HEADER MATCHES "^Bearer ")
    set(AUTH_ERR "missing" PARENT_SCOPE)
    return()
  endif()

  string(SUBSTRING "${AUTH_HEADER}" 7 -1 TOKEN)
  string(STRIP "${TOKEN}" TOKEN)
  if(TOKEN STREQUAL "")
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()

  string(REPLACE "." ";" PARTS "${TOKEN}")
  list(LENGTH PARTS NP)
  if(NOT NP EQUAL 3)
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()
  list(GET PARTS 0 H64)
  list(GET PARTS 1 P64)
  list(GET PARTS 2 S64)
  if(H64 STREQUAL "" OR P64 STREQUAL "" OR S64 STREQUAL "")
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()

  b64url_decode("${H64}" HDR_JSON HDR_OK)
  if(NOT HDR_OK)
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()
  string(JSON ALG ERROR_VARIABLE E1 GET "${HDR_JSON}" "alg")
  if(E1 OR NOT ALG STREQUAL "HS256")
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()

  b64url_decode("${P64}" PAY_JSON PAY_OK)
  if(NOT PAY_OK)
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()
  string(JSON EXP ERROR_VARIABLE E2 GET "${PAY_JSON}" "exp")
  if(E2)
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()
  string(JSON EXP_TYPE ERROR_VARIABLE E2b TYPE "${PAY_JSON}" "exp")
  if(E2b OR NOT EXP_TYPE STREQUAL "NUMBER")
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()
  if(NOT EXP MATCHES "^[0-9]+$")
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()
  string(TIMESTAMP NOW "%s")
  if(EXP LESS NOW)
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()

  hmac_sha256_b64url("${H64}.${P64}" "${SECRET}" EXPECTED)
  if(EXPECTED STREQUAL "")
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()
  if(NOT EXPECTED STREQUAL S64)
    set(AUTH_ERR "invalid" PARENT_SCOPE)
    return()
  endif()

  string(JSON SUB   ERROR_VARIABLE E3 GET  "${PAY_JSON}" "sub")
  if(E3)
    set(AUTH_ERR "payload" PARENT_SCOPE)
    return()
  endif()
  string(JSON STYP  ERROR_VARIABLE E4 TYPE "${PAY_JSON}" "sub")
  if(E4)
    set(AUTH_ERR "payload" PARENT_SCOPE)
    return()
  endif()
  string(JSON UNAME ERROR_VARIABLE E5 GET  "${PAY_JSON}" "username")
  if(E5)
    set(AUTH_ERR "payload" PARENT_SCOPE)
    return()
  endif()
  string(JSON UTYP  ERROR_VARIABLE E6 TYPE "${PAY_JSON}" "username")
  if(E6)
    set(AUTH_ERR "payload" PARENT_SCOPE)
    return()
  endif()

  if(NOT (STYP STREQUAL "STRING" OR STYP STREQUAL "NUMBER"))
    set(AUTH_ERR "payload" PARENT_SCOPE)
    return()
  endif()
  if(NOT SUB MATCHES "^[1-9][0-9]*$")
    set(AUTH_ERR "payload" PARENT_SCOPE)
    return()
  endif()
  if(NOT UTYP STREQUAL "STRING")
    set(AUTH_ERR "payload" PARENT_SCOPE)
    return()
  endif()

  set(AUTH_OK TRUE PARENT_SCOPE)
  set(AUTH_SUB "${SUB}" PARENT_SCOPE)
  set(AUTH_USERNAME "${UNAME}" PARENT_SCOPE)
endfunction()

function(require_auth AUTH_HEADER SECRET)
  check_auth("${AUTH_HEADER}" "${SECRET}")
  if(AUTH_OK)
    set(AUTH_SUB "${AUTH_SUB}" PARENT_SCOPE)
    set(AUTH_USERNAME "${AUTH_USERNAME}" PARENT_SCOPE)
    set(AUTH_PASSED TRUE PARENT_SCOPE)
    return()
  endif()
  if(AUTH_ERR STREQUAL "missing")
    send_error(401 "Unauthorized" "missing bearer token")
  elseif(AUTH_ERR STREQUAL "payload")
    send_error(401 "Unauthorized" "invalid token payload")
  else()
    send_error(401 "Unauthorized" "invalid or expired token")
  endif()
endfunction()