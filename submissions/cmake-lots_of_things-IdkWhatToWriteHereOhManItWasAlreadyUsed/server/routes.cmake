function(handle_health)
  execute_process(COMMAND "${POOL_CLI}" health
    OUTPUT_VARIABLE H_OUT ERROR_VARIABLE H_ERR RESULT_VARIABLE H_RC)
  if(NOT H_RC EQUAL 0)
    string(STRIP "${H_ERR}" H_ERR)
    if(H_ERR STREQUAL "")
      set(H_ERR "pool unavailable")
    endif()
    json_escape("${H_ERR}" HE)
    send_response(503 "Service Unavailable"
      "{\"status\":\"degraded\",\"db\":\"unreachable\",\"error\":\"${HE}\"}")
    return()
  endif()
  string(TIMESTAMP NOW "%s")
  math(EXPR UPTIME "${NOW} - ${START_TIME}")
  send_response(200 "OK" "{\"status\":\"ok\",\"db\":\"ok\",\"uptime_s\":${UPTIME}}")
endfunction()

function(handle_feed)
  execute_process(COMMAND "${POOL_CLI}" feed
    OUTPUT_VARIABLE F_OUT ERROR_VARIABLE F_ERR RESULT_VARIABLE F_RC)
  if(NOT F_RC EQUAL 0)
    send_error(500 "Internal Server Error" "internal server error")
    return()
  endif()
  string(STRIP "${F_OUT}" F_OUT)
  send_response(200 "OK" "${F_OUT}")
endfunction()

function(handle_get_post ID)
  execute_process(COMMAND "${POOL_CLI}" post_by_id "${ID}"
    OUTPUT_VARIABLE P_OUT ERROR_VARIABLE P_ERR RESULT_VARIABLE P_RC)
  if(NOT P_RC EQUAL 0)
    string(STRIP "${P_ERR}" P_ERR)
    if(P_ERR STREQUAL "post not found")
      send_error(404 "Not Found" "post not found")
    else()
      send_error(500 "Internal Server Error" "internal server error")
    endif()
    return()
  endif()
  string(STRIP "${P_OUT}" P_OUT)
  send_response(200 "OK" "${P_OUT}")
endfunction()

# AUTH_SUB — из JWT (sub), AUTH_USERNAME — из JWT (username)
function(handle_create_post AUTH_SUB AUTH_USERNAME BODY)
  extract_body_field("${BODY}" BF BOK BERR)
  if(NOT BOK)
    if(BERR STREQUAL "malformed")
      send_error(400 "Bad Request" "malformed JSON body")
    elseif(BERR STREQUAL "too_long")
      send_error(400 "Bad Request" "body must be at most 500 characters")
    else()
      send_error(400 "Bad Request" "body is required")
    endif()
    return()
  endif()

  execute_process(COMMAND "${POOL_CLI}" insert_post "${AUTH_SUB}" "${BF}"
    OUTPUT_VARIABLE IP_OUT ERROR_VARIABLE IP_ERR RESULT_VARIABLE IP_RC)
  if(NOT IP_RC EQUAL 0)
    send_error(500 "Internal Server Error" "internal server error")
    return()
  endif()
  string(STRIP "${IP_OUT}" IP_OUT)
  string(JSON NEW_ID GET "${IP_OUT}" "id")
  string(JSON NEW_CA GET "${IP_OUT}" "created_at")

  json_post("${NEW_ID}" "${BF}" "${NEW_CA}" "${AUTH_USERNAME}" 0 POST_JSON)
  send_response(201 "Created" "{\"post\":${POST_JSON}}")
endfunction()

function(handle_like ID AUTH_SUB)
  execute_process(COMMAND "${POOL_CLI}" insert_like "${AUTH_SUB}" "${ID}"
    OUTPUT_VARIABLE L_OUT ERROR_VARIABLE L_ERR RESULT_VARIABLE L_RC)
  if(NOT L_RC EQUAL 0)
    string(STRIP "${L_ERR}" L_ERR)
    if(L_ERR STREQUAL "post not found")
      send_error(404 "Not Found" "post not found")
    else()
      send_error(500 "Internal Server Error" "internal server error")
    endif()
    return()
  endif()
  string(STRIP "${L_OUT}" L_OUT)
  if(L_OUT MATCHES "\"already_liked\":(true|false)")
    set(ALREADY "${CMAKE_MATCH_1}")
  else()
    set(ALREADY "false")
  endif()
  if(ALREADY STREQUAL "true")
    send_response(200 "OK" "{\"liked\":true,\"already_liked\":true,\"post_id\":${ID}}")
  else()
    send_response(201 "Created" "{\"liked\":true,\"already_liked\":false,\"post_id\":${ID}}")
  endif()
endfunction()