<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>feed</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
    <!-- workstation GC without background GC: no GC threads at all; the rare GC runs on the loop that allocated -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <!-- NativeAOT: no JIT, no tiering threads, no call counting, no libcoreclr -->
    <PublishAot>true</PublishAot>
    <OptimizationPreference>Speed</OptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <MetricsSupport>false</MetricsSupport>
    <!-- only for the JIT fallback (build.sh with FEED_JIT=1) -->
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <!-- the gzip trailer's CRC-32, vectorized -->
  <ItemGroup>
    <PackageReference Include="System.IO.Hashing" Version="10.0.13" />
  </ItemGroup>

  <!-- on Linux the libc calls bind at link time; the box builds for itself, so AVX2 and BMI are there -->
  <ItemGroup Condition="$(RuntimeIdentifier.StartsWith('linux'))">
    <DirectPInvoke Include="libc" />
  </ItemGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
    <IlcInstructionSet>x86-64-v3</IlcInstructionSet>
  </PropertyGroup>

</Project>
