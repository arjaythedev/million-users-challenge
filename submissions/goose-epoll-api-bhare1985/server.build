// Native part of the server: the libpq shim and the epoll loop, built against the pinned libpq and ISA-L that build.sh puts in deps/.
c_sources = ["shim.c", "io.c"];
c_include = ["deps/postgresql-18.6/src/interfaces/libpq", "deps/postgresql-18.6/src/include", "deps/isa-l-2.31.1/include"];
c_libs = ["pq", "pgcommon_shlib", "pgport_shlib", "isal", "m", "pthread", "dl"];
output = "bin/server";
