-- Which CPUs the workers run on: those this process may use (its affinity mask), less the one that takes the NIC's
-- receive interrupt when the NIC has a single receive queue. That CPU does the first part of every packet's work
-- (the interrupt, NAPI, GRO and handing packets on to the other CPUs), and a worker there would compete with it.
-- (The idea is from asm-epoll-nickita-khylkouski.)
require 'c'

global CpuList = @record{n: cint, cpu: [1024]cint}

local line: [16384]cchar   -- the line just read from a /proc file

local function next_line(f: *C.FILE): boolean
  return C.fgets((@cstring)(&line[0]), #line, f) ~= nilptr
end

-- The CPUs in this process's affinity mask, in order.
local function affinity_cpus(list: *CpuList): void
  local mask: [16]uint64
  list.n = 0
  if sched_getaffinity(0, 128, &mask) ~= 0 then return end
  for c: cint = 0, < 1024 do
    if (mask[c // 64] >> (c % 64)) & 1 ~= 0 then
      list.cpu[list.n] = c
      list.n = list.n + 1
    end
  end
end

-- The CPU numbers of a /proc/interrupts or /proc/softirqs header line ("CPU0 CPU1 ..."), in column order.
local function header_cpus(s: cstring, cols: *CpuList): void
  cols.n = 0
  local p = s
  while cols.n < 1024 do
    local q = C.strstr(p, 'CPU')
    if q == nilptr then break end
    local endp: cstring
    cols.cpu[cols.n] = (@cint)(C.strtol((@cstring)(&(@Bytes)(q)[3]), &endp, 10))
    cols.n = cols.n + 1
    p = endp
  end
end

-- The numbers after the first ':' of a line, one per column. Returns how many there were.
local function line_counts(s: cstring, n: cint, counts: *[1024]uint64): cint
  local colon = C.strchr(s, 58)   -- ':'
  if colon == nilptr then return 0 end
  local p = (@cstring)(&(@Bytes)(colon)[1])
  local got: cint = 0
  while got < n do
    local endp: cstring
    local v = C.strtoull(p, &endp, 10)
    if endp == p then break end
    counts[got] = v
    got = got + 1
    p = endp
  end
  return got
end

-- The CPU that takes the receive interrupt of a virtio-net NIC with one receive queue: its IRQ's effective
-- affinity, or the CPU that counted the most of it if that lists several. -1 with several queues, -2 without
-- virtio-net.
local function nic_irq_cpu(): cint
  local f = C.fopen('/proc/interrupts', 'r')
  if f == nilptr then return -2 end
  local cols: CpuList
  local counts: [1024]uint64
  local irq: cint = -1
  local queues: cint = 0
  local busiest: cint = -1
  if next_line(f) then header_cpus((@cstring)(&line[0]), &cols) end
  while next_line(f) do
    local s = (@cstring)(&line[0])
    if C.strstr(s, 'virtio') ~= nilptr and C.strstr(s, '-input.') ~= nilptr then
      queues = queues + 1
      irq = C.atoi(s)
      local got = line_counts(s, cols.n, &counts)
      local best: uint64 = 0
      for i: cint = 0, < got do
        if counts[i] > best then
          best = counts[i]
          busiest = cols.cpu[i]
        end
      end
    end
  end
  C.fclose(f)
  if queues == 0 then return -2 end
  if queues > 1 then return -1 end
  local path: [64]cchar
  C.snprintf((@cstring)(&path[0]), #path, '/proc/irq/%d/effective_affinity_list', irq)
  local g = C.fopen((@cstring)(&path[0]), 'r')
  if g ~= nilptr then
    local ok = next_line(g)
    C.fclose(g)
    local s = (@cstring)(&line[0])
    if ok and C.strchr(s, 44) == nilptr and C.strchr(s, 45) == nilptr then return C.atoi(s) end   -- no ',' or '-'
  end
  return busiest
end

-- Without virtio-net: the CPU whose NET_RX softirq count is more than four times every other CPU's (-1 if none).
local function net_rx_cpu(): cint
  local f = C.fopen('/proc/softirqs', 'r')
  if f == nilptr then return -1 end
  local cols: CpuList
  local counts: [1024]uint64
  local got: cint = 0
  if next_line(f) then header_cpus((@cstring)(&line[0]), &cols) end
  while next_line(f) do
    local s = (@cstring)(&line[0])
    if C.strstr(s, 'NET_RX:') ~= nilptr then
      got = line_counts(s, cols.n, &counts)
      break
    end
  end
  C.fclose(f)
  local top: cint = -1
  for i: cint = 0, < got do
    if top < 0 or counts[i] > counts[top] then top = i end
  end
  if top < 0 then return -1 end
  for i: cint = 0, < got do
    if i ~= top and counts[top] <= 4 * counts[i] then return -1 end
  end
  return cols.cpu[top]
end

-- The CPUs for the workers in list, and the one left out for the NIC's interrupt (-1 for none). A CPU is only left
-- out when four or more are there.
global function worker_cpus(list: *CpuList, skip_irq: boolean): cint
  affinity_cpus(list)
  if not skip_irq or list.n < 4 then return -1 end
  local cpu = nic_irq_cpu()
  if cpu == -2 then cpu = net_rx_cpu() end
  if cpu < 0 then return -1 end
  for i: cint = 0, < list.n do
    if list.cpu[i] == cpu then
      for j: cint = i, < list.n - 1 do list.cpu[j] = list.cpu[j + 1] end
      list.n = list.n - 1
      return cpu
    end
  end
  return -1
end
