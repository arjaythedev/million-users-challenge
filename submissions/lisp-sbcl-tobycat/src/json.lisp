;;;; Strict JSON parsing (RFC 8259) from UTF-8 octets, and JSON string output.
;;;; Objects are (:obj . alist) with the last duplicate key first, arrays (:arr . list),
;;;; strings are Lisp strings, numbers are exact rationals, literals are :true :false :null.

(in-package :mu)

(defun json-parse (v start end)
  "Returns (values value T), or (values NIL NIL) if V[start,end) is not one valid JSON text."
  (declare (type octets v) (type fixnum start end))
  (let ((pos start))
    (declare (type fixnum pos))
    (labels ((fail () (throw 'json-fail nil))
             (ws () (loop while (and (< pos end) (member (aref v pos) '(32 9 10 13))) do (incf pos)))
             (peek () (if (< pos end) (aref v pos) (fail)))
             (expect (b) (if (and (< pos end) (= (aref v pos) b)) (incf pos) (fail)))
             (value ()
               (ws)
               (let ((c (peek)))
                 (case c
                   (123 (obj)) (91 (arr)) (34 (str))
                   (116 (lit "true" :true)) (102 (lit "false" :false)) (110 (lit "null" :null))
                   (t (if (or (= c 45) (<= 48 c 57)) (num) (fail))))))
             (lit (word val)
               (loop for ch across word do (expect (char-code ch)))
               val)
             (obj ()
               (incf pos) (ws)
               (if (= (peek) 125)
                   (progn (incf pos) (list :obj))
                   (let ((pairs '()))
                     (loop (ws)
                           (unless (= (peek) 34) (fail))
                           (let ((k (str)))
                             (ws) (expect 58)
                             (push (cons k (value)) pairs))
                           (ws)
                           (case (peek)
                             (44 (incf pos))
                             (125 (incf pos) (return (cons :obj pairs)))
                             (t (fail)))))))
             (arr ()
               (incf pos) (ws)
               (if (= (peek) 93)
                   (progn (incf pos) (list :arr))
                   (let ((items '()))
                     (loop (push (value) items)
                           (ws)
                           (case (peek)
                             (44 (incf pos))
                             (93 (incf pos) (return (cons :arr (nreverse items))))
                             (t (fail)))))))
             (digits ()
               (let ((s pos) (n 0))
                 (loop while (and (< pos end) (<= 48 (aref v pos) 57))
                       do (setf n (+ (* n 10) (- (aref v pos) 48))) (incf pos))
                 (when (= s pos) (fail))
                 (values n (- pos s))))
             (num ()
               (let ((neg nil) (m 0) (e 0))
                 (when (= (peek) 45) (setf neg t) (incf pos))
                 (if (= (peek) 48)
                     (incf pos)
                     (setf m (digits)))
                 (when (and (< pos end) (= (aref v pos) 46))
                   (incf pos)
                   (multiple-value-bind (f nd) (digits)
                     (setf m (+ (* m (expt 10 nd)) f) e (- nd))))
                 (when (and (< pos end) (member (aref v pos) '(101 69)))
                   (incf pos)
                   (let ((eneg nil))
                     (case (peek) (43 (incf pos)) (45 (incf pos) (setf eneg t)))
                     (let ((x (min (digits) 400)))
                       (incf e (if eneg (- x) x)))))
                 (let ((x (* m (expt 10 (max -800 (min e 800))))))
                   (if neg (- x) x))))
             (hex4 ()
               (let ((n 0))
                 (dotimes (i 4)
                   (let* ((c (peek)) (d (digit-char-p (code-char c) 16)))
                     (unless d (fail))
                     (setf n (+ (* n 16) d)) (incf pos)))
                 n))
             (cont (b) (if (= (logand b #xc0) #x80) (logand b #x3f) nil))
             (str ()
               (incf pos)
               (let ((out (make-array 16 :element-type 'character :adjustable t :fill-pointer 0)))
                 (loop
                   (let ((b (peek)))
                     (cond
                       ((= b 34) (incf pos) (return (coerce out 'simple-string)))
                       ((< b 32) (fail))
                       ((= b 92)
                        (incf pos)
                        (let ((e (peek)))
                          (incf pos)
                          (vector-push-extend
                           (case e
                             (34 #\") (92 #\\) (47 #\/) (98 (code-char 8)) (102 (code-char 12))
                             (110 (code-char 10)) (114 (code-char 13)) (116 (code-char 9))
                             (117 (let ((u (hex4)))
                                    (cond ((and (<= #xd800 u #xdbff) (< (+ pos 5) end)
                                                (= (aref v pos) 92) (= (aref v (1+ pos)) 117))
                                           (let ((save pos))
                                             (incf pos 2)
                                             (let ((lo (hex4)))
                                               (if (<= #xdc00 lo #xdfff)
                                                   (code-char (+ #x10000 (ash (- u #xd800) 10) (- lo #xdc00)))
                                                   (progn (setf pos save) (code-char #xfffd))))))
                                          ((<= #xd800 u #xdfff) (code-char #xfffd))
                                          (t (code-char u)))))
                             (t (fail)))
                           out)))
                       ((< b #x80) (incf pos) (vector-push-extend (code-char b) out))
                       (t
                        ;; UTF-8 sequence; invalid bytes become U+FFFD
                        (let* ((n (cond ((= (logand b #xe0) #xc0) 1) ((= (logand b #xf0) #xe0) 2)
                                        ((= (logand b #xf8) #xf0) 3) (t 0)))
                               (cp (logand b (case n (1 #x1f) (2 #x0f) (3 #x07) (t 0))))
                               (ok (plusp n)))
                          (incf pos)
                          (dotimes (i n)
                            (let ((c (and ok (< pos end) (cont (aref v pos)))))
                              (if c (progn (setf cp (logior (ash cp 6) c)) (incf pos)) (setf ok nil))))
                          (when (and ok (or (< cp (case n (1 #x80) (2 #x800) (t #x10000)))
                                            (<= #xd800 cp #xdfff) (> cp #x10ffff)))
                            (setf ok nil))
                          (vector-push-extend (if ok (code-char cp) (code-char #xfffd)) out)))))))))
      (catch 'json-fail
        (let ((val (value)))
          (ws)
          (when (= pos end) (return-from json-parse (values val t)))))
      (values nil nil))))

(defun json-get (obj key)
  (and (consp obj) (eq (car obj) :obj) (cdr (assoc key (cdr obj) :test #'string=))))

(defun json-get* (obj key)
  "Like JSON-GET, but the second value says whether the key is present."
  (if (and (consp obj) (eq (car obj) :obj))
      (let ((p (assoc key (cdr obj) :test #'string=))) (values (cdr p) (and p t)))
      (values nil nil)))

(defun js-space-p (code)
  "The whitespace JavaScript's String.prototype.trim removes."
  (or (<= 9 code 13) (= code 32) (= code #xa0) (= code #x1680) (<= #x2000 code #x200a)
      (= code #x2028) (= code #x2029) (= code #x202f) (= code #x205f) (= code #x3000) (= code #xfeff)))

(defun js-trim (s)
  (let* ((a (or (position-if-not (lambda (c) (js-space-p (char-code c))) s) (length s)))
         (b (or (position-if-not (lambda (c) (js-space-p (char-code c))) s :from-end t) (1- a))))
    (subseq s a (1+ b))))

;;; JSON string output from UTF-8 octets: escape " \ and control characters only.

(declaim (type octets +hexdig+))
(sb-ext:define-load-time-global +hexdig+ (ascii "0123456789abcdef"))

(declaim (inline json-plain-word-p))
(defun json-plain-word-p (x)
  "True when none of the 8 bytes of X is below 32, a quote or a backslash."
  (declare (type (unsigned-byte 64) x) (optimize speed (safety 0)))
  (let* ((hi #x8080808080808080) (ones #x0101010101010101)
         (nx (logxor x #xffffffffffffffff))
         (lt32 (logand (ldb (byte 64 0) (- x (* 32 ones))) nx hi))
         (q (logxor x (* 34 ones))) (bs (logxor x (* 92 ones)))
         (zq (logand (ldb (byte 64 0) (- q ones)) (logxor q #xffffffffffffffff) hi))
         (zb (logand (ldb (byte 64 0) (- bs ones)) (logxor bs #xffffffffffffffff) hi)))
    (zerop (logior lt32 zq zb))))

(defun ob-json-str (b v &optional (start 0) (end (length v)))
  (declare (type obuf b) (type octets v) (type fixnum start end) (optimize speed (safety 0)))
  (ob-room b (+ 2 (* 6 (- end start))))
  (let ((d (obuf-data b)) (o (obuf-len b)) (i start))
    (declare (type octets d) (type fixnum o i))
    (setf (aref d o) 34) (incf o)
    (loop
      ;; a run of bytes that need no escaping: 8 at a time, then one at a time, then one copy
      (let ((j i))
        (declare (type fixnum j))
        (with-pinned-objects (v)
          (let ((sap (vector-sap v)))
            (loop while (and (<= (+ j 8) end) (json-plain-word-p (sap-ref-64 sap j))) do (incf j 8))))
        (loop while (and (< j end) (let ((c (aref v j))) (and (>= c 32) (/= c 34) (/= c 92)))) do (incf j))
        (when (> j i) (replace d v :start1 o :start2 i :end2 j) (incf o (- j i)) (setf i j)))
      (when (>= i end) (return))
      (let ((c (aref v i)))
        (cond ((or (= c 34) (= c 92)) (setf (aref d o) 92 (aref d (1+ o)) c) (incf o 2))
              (t (let ((s (case c (10 110) (13 114) (9 116) (8 98) (12 102) (t 0))))
                   (if (plusp s)
                       (progn (setf (aref d o) 92 (aref d (1+ o)) s) (incf o 2))
                       (progn (setf (aref d o) 92 (aref d (+ o 1)) 117 (aref d (+ o 2)) 48
                                    (aref d (+ o 3)) 48 (aref d (+ o 4)) (aref +hexdig+ (ash c -4))
                                    (aref d (+ o 5)) (aref +hexdig+ (logand c 15)))
                              (incf o 6)))))))
      (incf i))
    (setf (aref d o) 34) (incf o)
    (setf (obuf-len b) o)))
